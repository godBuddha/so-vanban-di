# Env cho backend chạy TRỰC TIẾP bên ngoài Docker (môi trường dev: npm run dev trong server/)
# Copy thành server/.env. Lưu ý: dotenv đọc file .env theo thư mục chạy lệnh (cwd) = server/.
# Production KHÔNG dùng file này — biến môi trường do docker-compose.prod.yml truyền từ .env ở gốc dự án.

# CSDL dev = container docker compose dev ở thư mục gốc (postgres 16 + pgvector, localhost:5432)
DATABASE_URL=postgresql://vanban:vanban_dev@localhost:5432/vanban

# Secret JWT — dev để trống sẽ dùng giá trị dev tự động; production bắt buộc đặt
# (deploy.sh sẽ từ chối deploy nếu thiếu/giữ placeholder)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Tuỳ chọn
# PORT=3000
# NODE_ENV=development
# UNIT_ABBR=UBND
# UNIT_NAME=UBND Phường ABC
# UPLOAD_MAX_MB=20
# UPLOAD_DIR=uploads
# OCR_URL=http://ocr:8000
# OLLAMA_BASE_URL=http://ollama:11434
