# ===================== SỔ VĂN BẢN ĐI — cấu hình =====================
# Copy thành .env và điền giá trị thật. KHÔNG commit file .env.
# Secret ngẫu nhiên tạo bằng: openssl rand -hex 32

# --- PostgreSQL ---
POSTGRES_USER=vanban
POSTGRES_PASSWORD=doi_mat_khau_nay
POSTGRES_DB=vanban

# DATABASE_URL bên dưới CHỈ dùng khi chạy backend bên ngoài Docker (môi trường dev:
# npm run dev trong thư mục server/, CSDL là container docker compose dev trên localhost).
# Ở PRODUCTION không dùng dòng này — compose tự ghép từ POSTGRES_USER/PASSWORD/DB.
DATABASE_URL=postgresql://vanban:vanban_dev@localhost:5432/vanban

# --- Bảo mật (BẮT BUỘC đổi khi production — deploy.sh sẽ từ chối nếu giữ placeholder) ---
# openssl rand -hex 32  ×2  (2 secret phải khác nhau)
JWT_SECRET=chuoi_ngau_nhien_64_ky_tu
JWT_REFRESH_SECRET=chuoi_ngau_nhien_khac_64_ky_tu

# --- Cấu hình cơ quan ---
UNIT_ABBR=UBND                # viết tắt đơn vị trong số ký hiệu, VD 145/2026/CV-UBND
UNIT_NAME=UBND Phường ABC     # tên cơ quan in trên trang sổ

# --- Tên miền (production) ---
DOMAIN=vanban.congty.vn
ACME_EMAIL=admin@congty.vn
# Cloudflare API Token (quyền Zone.DNS Edit) — dùng cấp SSL tự động
CF_DNS_API_TOKEN=

# --- App ---
NODE_ENV=production
PORT=3000
UPLOAD_MAX_MB=20

# --- Dịch vụ nội bộ (app đọc qua env; giữa các container) ---
OCR_URL=http://ocr:8000             # dịch vụ OCR nhận dạng chữ (mạng nội bộ compose)
OLLAMA_BASE_URL=http://ollama:11434 # AI local (tùy chọn, chỉ khi bật profile "ai")

# --- Trợ lý AI ---
# KHÔNG đặt API key của AI provider (OpenAI/Gemini/...) trong file .env.
# Provider + key được cấu hình trong giao diện: Quản trị → Trợ lý AI.
# AI local (Ollama) cũng cấu hình tại đó, trỏ tới OLLAMA_BASE_URL ở trên.

# --- Tài khoản quản trị đầu tiên ---
# KHÔNG đặt trong .env: lần đầu truy cập web sẽ hiện trang "Cài đặt ban đầu",
# người quản trị tự đặt tên đăng nhập + mật khẩu tại đó (chỉ khi hệ thống còn trống).
